menu "Over the Air Updates"
comment "OTA"

config HAS_OTA
        bool "Over the air updates"
        default y
        help
          Enables over the air updates via the repository setup

config PACKAGE_FEED_URIS
        string "Server URLs"
        default "https://127.0.0.1:8088/${RELEASE_TYPE}/ota/${DISTRO_CODENAME}/${DISTRO_VERSION}/${RELEASE_TYPE}/${TUNE_ARCH}"
        depends on HAS_OTA
        help
          The repos that you want to load your packages to after running packageindex
          this is what generates(depening on the type) the /etc/apt/source.list  on the target image as well.
          See also https://docs.yoctoproject.org/ref-manual/variables.html#term-PACKAGE_FEED_URIS

choice OTA_TYPE
        prompt "The Type of OTA Packages along with the target tools."
        depends on HAS_OTA
        default RPM if HAS_OTA
        config RPM
                bool "Rpms with Dnf(Dandified YUM)"
        config APT
                bool "Deb's Apt(Advanced Package Tool)"
        config IPK
                bool "IPK's with OPKG(Open PacKaGe Management)"
        config TAR
                bool "tar.gz only."
endchoice

# READONLY BELOW
config PACKAGE_FEED_BASE_PATHS
        string
        depends on HAS_OTA
        default "deb" if APT
        default "rpm" if RPM
        default "ipk" if IPK
        default "tar"  if TAR
        default "none" if !HAS_OTA

config PACKAGE_TYPE
        string
        depends on HAS_OTA
          default "deb" if APT
          default "rpm" if RPM
          default "ipk" if IPK
          default "tar"  if TAR
          default "none" if !HAS_OTA

config PACKAGE_CLASSES
        string
        depends on HAS_OTA
          default "package_deb" if APT
          default "package_rpm" if RPM
          default "package_ipk" if IPK
          default "package_tar"  if TAR
          default "package_none" if !HAS_OTA

config PACKAGE_TOOLS
        string
        depends on HAS_OTA
          default " dpkg apt " if APT
          default " rpm dnf " if RPM
          default " opkg " if IPK
          default " tar "  if TAR
          default " tar " if !HAS_OTA

config KAS_INCLUDE_HAS_OTA
        string
        default "distro/ota/ota.yml" if HAS_OTA
        default "distro/ota/no-ota.yml" if !HAS_OTA


endmenu

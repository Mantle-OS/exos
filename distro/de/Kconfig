menu "Images"
comment "Avalible Images"

config HAS_CORE_IMG
    bool "mantle-image-core"
    default y
config KAS_INCLUDE_MANTLE_IMAGE_CORE
  string
  default "distro/de/core.yml" if HAS_CORE_IMG

